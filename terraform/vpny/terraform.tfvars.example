# Copy to terraform.tfvars and fill in. Values are in the OCI Console:
# Profile menu -> Tenancy: <name> (tenancy OCID); region from the top bar.
region       = "us-ashburn-1"
tenancy_ocid = "ocid1.tenancy.oc1..CHANGE-ME"

